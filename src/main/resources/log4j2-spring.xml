<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN"
               packages="com.infinitesoft.pos_relational_data_service.logging">
    <Appenders>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS}  %-5level %pid --- [%15.15t] %-40.40logger{39} : %msg%n%xwEx"/>
        </Console>

        <!-- Sends each log event to InfluxDB 3 (logs-infinito).
             Implementation: com.infinitesoft.pos_relational_data_service.logging.InfluxLogAppender
             The appender is non-blocking; if Spring isn't ready or InfluxDB is
             down the writer spools to disk and retries. -->
        <InfluxLogAppender name="InfluxAppender"/>

    </Appenders>

    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="InfluxAppender" level="${spring:logging.db.level:-INFO}"/>
        </Root>
    </Loggers>
</Configuration>
